@model List<Do_An_Net_CuoiKy.Models.Product>
@{
ViewData["Title"] = "Trang Chủ";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1>Chăm Sóc Thú Cưng Của Bạn</h1>
                <p>Khám phá bộ sưu tập đầy đủ các sản phẩm chất lượng cao cho thú cưng yêu quý của bạn</p>
                <a href="@Url.Action("Index", "Product")" class="btn btn-light btn-lg me-2">
                    <i class="fas fa-shopping-bag me-2"></i>Mua Ngay
                </a>
                <a href="#categories" class="btn btn-outline-light btn-lg">
                    <i class="fas fa-th me-2"></i>Xem Danh Mục
                </a>
            </div>
            <div class="col-md-6 text-center">
                <img src="~/logo.png" asp-append-version="true" alt="Pet Shop Logo" class="img-fluid rounded">
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->

<section id="categories" class="py-5">
    <div class="container">
        <div class="section-title text-center mb-4">
            <h2>Danh Mục Cửa Hàng</h2>
            <p>Tất cả những gì thú cưng của bạn cần</p>
        </div>
        <div class="row g-4">

            <div class="col-md-3 col-sm-6">
                <a asp-controller="Product" asp-action="Index" asp-route-categoryIds="1" class="text-decoration-none text-dark">
                    <div class="category-card h-100 text-center p-4 border rounded shadow-sm hover-effect">
                        <i class="fas fa-dog fa-3x mb-3" style="color: #8B4513;"></i>
                        <h5>Chó cưng</h5>
                        <p class="text-muted small">Những chú cún cưng đáng yêu </p>
                    </div>
                </a>
            </div>

            <div class="col-md-3 col-sm-6">
                <a asp-controller="Product" asp-action="Index" asp-route-categoryIds="2" class="text-decoration-none text-dark">
                    <div class="category-card h-100 text-center p-4 border rounded shadow-sm hover-effect">
                        <i class="fas fa-cat fa-3x text-warning mb-3"></i>
                        <h5>Mèo cưng</h5>
                        <p class="text-muted small">Những chú mèo dễ thương</p>
                    </div>
                </a>
            </div>

            <div class="col-md-3 col-sm-6">
                <a asp-controller="Product" asp-action="Index" asp-route-categoryIds="3" class="text-decoration-none text-dark">
                    <div class="category-card h-100 text-center p-4 border rounded shadow-sm hover-effect">
                        <i class="fas fa-tshirt fa-3x text-info mb-3"></i>
                        <h5>Phụ Kiện</h5>
                        <p class="text-muted small">Quần áo, vòng cổ...</p>
                    </div>
                </a>
            </div>

            <div class="col-md-3 col-sm-6">
                <a asp-controller="Product" asp-action="Index" asp-route-categoryIds="4" class="text-decoration-none text-dark">
                    <div class="category-card h-100 text-center p-4 border rounded shadow-sm hover-effect">
                        <i class="fas fa-drumstick-bite fa-3x text-danger mb-3"></i>
                        <h5>Thức ăn</h5>
                        <p class="text-muted small">Thức ăn cho thú cưng </p>
                    </div>
                </a>
            </div>

        </div>
    </div>
</section>

<style>
    .hover-effect {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background-color: white;
    }

        .hover-effect:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
            cursor: pointer;
            border-color: #0d6efd !important; /* Đổi màu viền khi hover */
        }
</style>
<!-- Featured Products Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="section-title text-center mb-5">
            <h2>Sản Phẩm Nổi Bật</h2>
            <p>Những sản phẩm mới nhất vừa về shop</p>
        </div>

        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card product-card h-100 shadow-sm border-0">

                        @if (item.OldPrice > item.Price)
                        {
                            <span class="badge bg-danger position-absolute top-0 start-0 m-2">
                                -@((int)((item.OldPrice - item.Price) / item.OldPrice * 100))%
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success position-absolute top-0 start-0 m-2">Mới</span>
                        }

                        <div class="overflow-hidden" style="height: 250px;">
                            <img src="@item.ImageUrl" class="card-img-top w-100 h-100" style="object-fit: cover;"
                                 alt="@item.Name"
                                 onerror="this.src='https://via.placeholder.com/300x300?text=No+Image'">
                        </div>

                        <div class="card-body d-flex flex-column">
                            <div class="rating text-warning mb-2 small">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(item.Rating))
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                    else
                                    {

                                        <i class="far fa-star text-muted"></i>
                                    }
                                }
                                <span class="text-muted ms-1">(@item.ReviewCount)</span>
                            </div>

                            <h5 class="card-title text-truncate">
                                <a href="@Url.Action("Details", "Product", new { id = item.Id })" class="text-dark text-decoration-none" title="@item.Name">
                                    @item.Name
                                </a>
                            </h5>

                            <div class="price mb-3">
                                <span class="fw-bold text-danger fs-5">@item.Price.ToString("#,##0")đ</span>
                                @if (item.OldPrice > item.Price)
                                {
                                    <span class="text-decoration-line-through text-muted ms-2 small">
                                        @(((decimal)item.OldPrice).ToString("#,##0"))đ
                                    </span>
                                }
                            </div>

                            <div class="d-grid gap-2 mt-auto">
                                <button class="btn btn-primary btn-sm btnAddToCart" data-id="@item.Id">
                                    <i class="fas fa-cart-plus me-2"></i>Thêm Giỏ
                                </button>
                                <a href="@Url.Action("Details", "Product", new { id = item.Id })" class="btn btn-outline-secondary btn-sm">
                                    Xem Chi Tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a href="@Url.Action("Index", "Product")" class="btn btn-primary btn-lg px-5 rounded-pill shadow">
                Xem Tất Cả Sản Phẩm <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- Why Choose Us Section -->
<section class="py-5">
    <div class="container">
        <div class="section-title">
            <h2>Tại Sao Chọn Chúng Tôi</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-shipping-fast fa-3x text-primary"></i>
                </div>
                <h5>Giao Hàng Nhanh</h5>
                <p class="text-muted">Giao hàng toàn quốc trong 24-48 giờ</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-shield-alt fa-3x text-primary"></i>
                </div>
                <h5>Chất Lượng Đảm Bảo</h5>
                <p class="text-muted">Sản phẩm chính hãng, chất lượng cao</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-headset fa-3x text-primary"></i>
                </div>
                <h5>Hỗ Trợ 24/7</h5>
                <p class="text-muted">Đội ngũ tư vấn chuyên nghiệp</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
}