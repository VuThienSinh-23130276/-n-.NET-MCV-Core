@model List<Do_An_Net_CuoiKy.Models.Product>
@{
    ViewData["Title"] = "Trang Chủ";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1>Chăm Sóc Thú Cưng Của Bạn</h1>
                <p>Khám phá bộ sưu tập đầy đủ các sản phẩm chất lượng cao cho thú cưng yêu quý của bạn</p>
                <a href="@Url.Action("Index", "Product")" class="btn btn-light btn-lg me-2">
                    <i class="fas fa-shopping-bag me-2"></i>Mua Ngay
                </a>
                <a href="#categories" class="btn btn-outline-light btn-lg">
                    <i class="fas fa-th me-2"></i>Xem Danh Mục
                </a>
            </div>
            <div class="col-md-6 text-center">
                <img src="~/products/dog/sp1.jpg" alt="Pet Shop" class="img-fluid rounded">
            </div>
        </div>
    </div>
</section>

<!-- Categories Section -->
<section id="categories" class="py-5">
    <div class="container">
        <div class="section-title">
            <h2>Danh Mục Sản Phẩm</h2>
            <p>Khám phá các danh mục sản phẩm đa dạng cho thú cưng của bạn</p>
        </div>
        <div class="row g-4">
            <div class="col-md-3 col-sm-6">
                <div class="category-card">
                    <i class="fas fa-bone"></i>
                    <h5>Thức Ăn</h5>
                    <p class="text-muted">Thức ăn dinh dưỡng</p>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="category-card">
                    <i class="fas fa-baseball-ball"></i>
                    <h5>Đồ Chơi</h5>
                    <p class="text-muted">Đồ chơi vui nhộn</p>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="category-card">
                    <i class="fas fa-tshirt"></i>
                        <h5>Phụ Kiện</h5>
                    <p class="text-muted">Phụ kiện thời trang</p>
                    </div>
                </a>
            </div>
            <div class="col-md-3 col-sm-6">
                <div class="category-card">
                    <i class="fas fa-spa"></i>
                    <h5>Chăm Sóc</h5>
                    <p class="text-muted">Sản phẩm chăm sóc</p>
        </div>
    </div>
        </div>
    </div>
</section>

<!-- Featured Products Section -->
<section class="py-5 bg-light">
    <div class="container">
        <div class="section-title">
            <h2>Sản Phẩm Nổi Bật</h2>
            <p>Những sản phẩm được yêu thích nhất</p>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    var fallbackImageUrl = Url.Content("~/logo.png");
                    var imageUrl = string.IsNullOrWhiteSpace(item.ImageUrl)
                        ? fallbackImageUrl
                        : item.ImageUrl.Trim().Replace("\\", "/");
                    if (!string.IsNullOrWhiteSpace(imageUrl) &&
                        !imageUrl.StartsWith("http://") &&
                        !imageUrl.StartsWith("https://") &&
                        !imageUrl.StartsWith("/"))
                    {
                        if (imageUrl.StartsWith("~/"))
                        {
                            imageUrl = Url.Content(imageUrl);
                        }
                        else
                        {
                            imageUrl = "/" + imageUrl.TrimStart('/');
                        }
                    }

                    var hasDiscount = item.OldPrice.HasValue && item.OldPrice.Value > item.Price;

                    <div class="col-lg-3 col-md-4 col-sm-6">
                        <div class="card product-card h-100">
                            @if (hasDiscount)
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-2">-@((int)((item.OldPrice!.Value - item.Price) / item.OldPrice.Value * 100))%</span>
                            }
                            <img src="@imageUrl" class="card-img-top" alt="@item.Name" style="height: 250px; object-fit: cover;" onerror="this.src='@fallbackImageUrl'">
                            <div class="card-body d-flex flex-column">
                                <div class="rating mb-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(item.Rating)) { <i class="fas fa-star text-warning"></i> }
                                        else { <i class="far fa-star text-warning"></i> }
                                    }
                                    <span class="ms-1">(@item.Rating)</span>
                                </div>
                                <h5 class="card-title text-truncate">@item.Name</h5>
                                <div class="price mb-2">
                                    <span class="fw-bold text-danger fs-5">@item.Price.ToString("#,##0")đ</span>
                                    @if (hasDiscount)
                                    {
                                        <span class="old-price ms-2">@item.OldPrice!.Value.ToString("#,##0")đ</span>
                                    }
                                </div>
                                <div class="d-grid gap-2 mt-auto">
                                    <button class="btn btn-primary">
                                        <i class="fas fa-shopping-cart me-2"></i>Thêm Vào Giỏ
                                    </button>
                                    <a href="@Url.Action("Details", "Product", new { id = item.Id })" class="btn btn-outline-primary">Xem Chi Tiết</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning w-100 text-center">Không có sản phẩm nổi bật.</div>
            }
        </div>

        <div class="text-center mt-4">
            <a href="@Url.Action("Index", "Product")" class="btn btn-primary btn-lg">
                Xem Tất Cả Sản Phẩm <i class="fas fa-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- Why Choose Us Section -->
<section class="py-5">
    <div class="container">
        <div class="section-title">
            <h2>Tại Sao Chọn Chúng Tôi</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-shipping-fast fa-3x text-primary"></i>
                </div>
                <h5>Giao Hàng Nhanh</h5>
                <p class="text-muted">Giao hàng toàn quốc trong 24-48 giờ</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-shield-alt fa-3x text-primary"></i>
                </div>
                <h5>Chất Lượng Đảm Bảo</h5>
                <p class="text-muted">Sản phẩm chính hãng, chất lượng cao</p>
            </div>
            <div class="col-md-4 text-center">
                <div class="mb-3">
                    <i class="fas fa-headset fa-3x text-primary"></i>
                </div>
                <h5>Hỗ Trợ 24/7</h5>
                <p class="text-muted">Đội ngũ tư vấn chuyên nghiệp</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
}