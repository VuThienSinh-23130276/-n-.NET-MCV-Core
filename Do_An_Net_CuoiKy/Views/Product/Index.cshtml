@using X.PagedList.Mvc.Core
@using X.PagedList
@using X.PagedList.Web.Common

@model IPagedList<Do_An_Net_CuoiKy.Models.Product>

@{
    ViewData["Title"] = "Sản Phẩm";
}

<nav aria-label="breadcrumb" class="mb-4">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Sản Phẩm</li>
        </ol>
    </div>
</nav>

<section class="py-4">
    <div class="container">
        <div class="row">
            <div class="col-md-3 mb-4">
                <form id="filterForm" asp-action="Index" method="get">
                    <input type="hidden" name="searchString" value="@ViewBag.CurrentSearch" />
                    <input type="hidden" name="sortOrder" value="@ViewBag.CurrentSort" />

                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Bộ Lọc</h5>
                        </div>
                        <div class="card-body">

                            <div class="mb-4">
                                <h6 class="fw-bold mb-3">Danh Mục</h6>
                                @if (ViewBag.Categories != null)
                                {
                                    foreach (var cat in ViewBag.Categories)
                                    {
                                        bool isChecked = false;
                                        if (ViewBag.CurrentCategoryIds != null)
                                        {
                                            int[] currentIds = (int[])ViewBag.CurrentCategoryIds;
                                            isChecked = currentIds.Contains((int)cat.Id);
                                        }

                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="categoryIds" value="@cat.Id" id="cat_@cat.Id" @(isChecked ? "checked" : "")>
                                            <label class="form-check-label" for="cat_@cat.Id">@cat.Name</label>
                                        </div>
                                    }
                                }
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold mb-3">Khoảng Giá</h6>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="priceRange" value="" id="price_all" @(string.IsNullOrEmpty(ViewBag.CurrentPrice) ? "checked" : "")>
                                    <label class="form-check-label" for="price_all">Tất cả mức giá</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="priceRange" value="duoi100" id="price1" @(ViewBag.CurrentPrice == "duoi100" ? "checked" : "")>
                                    <label class="form-check-label" for="price1">Dưới 100.000đ</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="priceRange" value="100-300" id="price2" @(ViewBag.CurrentPrice == "100-300" ? "checked" : "")>
                                    <label class="form-check-label" for="price2">100k - 300k</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="priceRange" value="300-500" id="price3" @(ViewBag.CurrentPrice == "300-500" ? "checked" : "")>
                                    <label class="form-check-label" for="price3">300k - 500k</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="priceRange" value="tren500" id="price4" @(ViewBag.CurrentPrice == "tren500" ? "checked" : "")>
                                    <label class="form-check-label" for="price4">Trên 500k</label>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="fw-bold mb-3">Đánh Giá</h6>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="minRating" value="" id="rating_all" @(ViewBag.CurrentMinRating == null ? "checked" : "")>
                                    <label class="form-check-label" for="rating_all">Tất cả sao</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="minRating" value="5" id="rating5" @(ViewBag.CurrentMinRating == 5 ? "checked" : "")>
                                    <label class="form-check-label" for="rating5">
                                        <i class="fas fa-star text-warning"></i><i class="fas fa-star text-warning"></i><i class="fas fa-star text-warning"></i><i class="fas fa-star text-warning"></i><i class="fas fa-star text-warning"></i>
                                        <span class="small text-muted">(5/5)</span>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="minRating" value="4" id="rating4" @(ViewBag.CurrentMinRating == 4 ? "checked" : "")>
                                    <label class="form-check-label" for="rating4">
                                        <i class="fas fa-star text-warning"></i><i class="fas fa-star text-warning"></i><i class="fas fa-star text-warning"></i><i class="fas fa-star text-warning"></i><i class="far fa-star text-warning"></i>
                                        <span class="small text-muted">(Từ 4 sao)</span>
                                    </label>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Áp Dụng</button>
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100 mt-2">Đặt Lại</a>
                        </div>
                    </div>
                </form>
            </div>

            <div class="col-md-9">

                <div id="productContainer">
                    @await Html.PartialAsync("_ProductList", Model)
                </div>

                <div id="loading" class="text-center mt-5" style="display:none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        $(document).ready(function () {

            // Hàm chung để gọi AJAX
            function loadProducts(url, data) {
                $('#productContainer').css('opacity', '0.5'); // Làm mờ danh sách cũ
                $('#loading').show(); // Hiện icon loading

                $.ajax({
                    url: url,
                    data: data,
                    success: function (response) {
                        $('#productContainer').html(response); // Đổ dữ liệu mới vào
                        $('#productContainer').css('opacity', '1'); // Hết mờ
                        $('#loading').hide(); // Ẩn loading
                    },
                    error: function () {
                        alert("Có lỗi xảy ra khi tải dữ liệu!");
                        $('#loading').hide();
                        $('#productContainer').css('opacity', '1');
                    }
                });
            }

            // 1. Bắt sự kiện khi bấm nút "Áp Dụng" ở Sidebar
            $('#filterForm').submit(function (e) {
                e.preventDefault(); // Chặn không cho load lại trang
                var url = $(this).attr('action');
                var data = $(this).serialize(); // Gom dữ liệu: categoryIds=1&priceRange=duoi100...
                loadProducts(url, data);
            });

            // 2. Bắt sự kiện khi thay đổi Sắp xếp (Dropdown)
            // Vì cái dropdown nằm trong file Index nên bắt sự kiện change bình thường
            $('select[name="sortOrder"]').change(function() {
                 var url = $('#filterForm').attr('action');

                 // Gom dữ liệu từ form lọc + giá trị sắp xếp mới
                 var formData = $('#filterForm').serialize();
                 var sortValue = $(this).val();

                 // Ghép chuỗi thủ công một chút cho chắc ăn
                 var fullData = formData + "&sortOrder=" + sortValue;

                 loadProducts(url, fullData);
            });

            // 3. Bắt sự kiện khi bấm Phân trang (Số 1, 2, 3...)
            // Vì thanh phân trang nằm trong PartialView (được sinh ra sau), nên phải dùng 'on'
            $('body').on('click', '.pagination a', function (e) {
                e.preventDefault(); // Chặn link gốc
                var url = $(this).attr('href'); // Lấy link: /Product?page=2...

                if (url) {
                    loadProducts(url, "");
                }
            });
        });
    </script>
}