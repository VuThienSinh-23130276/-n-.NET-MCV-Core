@model Do_An_Net_CuoiKy.Models.Product
@{
    ViewData["Title"] = Model.Name;
    var fallbackImageUrl = Url.Content("~/logo.png");
    var imageUrl = string.IsNullOrWhiteSpace(Model.ImageUrl)
        ? fallbackImageUrl
        : Model.ImageUrl.Trim().Replace("\\", "/");
    if (!string.IsNullOrWhiteSpace(imageUrl) &&
        !imageUrl.StartsWith("http://") &&
        !imageUrl.StartsWith("https://") &&
        !imageUrl.StartsWith("/"))
    {
        if (imageUrl.StartsWith("~/"))
        {
            imageUrl = Url.Content(imageUrl);
        }
        else
        {
            imageUrl = "/" + imageUrl.TrimStart('/');
        }
    }
    var hasDiscount = Model.OldPrice.HasValue && Model.OldPrice.Value > Model.Price;
    var discountPercent = hasDiscount
        ? (int)Math.Round((Model.OldPrice.Value - Model.Price) / Model.OldPrice.Value * 100)
        : 0;
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Sản Phẩm</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi Tiết</li>
        </ol>
    </div>
</nav>

<!-- Product Details Section -->
<section class="py-4">
    <div class="container">
        <div class="row">
            <!-- Product Images -->
            <div class="col-md-6">
                <div class="mb-3">
                    <img src="@imageUrl" class="img-fluid rounded shadow" alt="@Model.Name" id="mainImage" onerror="this.src='@fallbackImageUrl'">
                </div>
                <div class="row g-2">
                    <div class="col-3">
                        <img src="@imageUrl" class="img-fluid rounded border cursor-pointer" onclick="changeImage(this.src)" alt="@Model.Name">
                    </div>
                    <div class="col-3">
                        <img src="@imageUrl" class="img-fluid rounded border cursor-pointer" onclick="changeImage(this.src)" alt="@Model.Name">
                    </div>
                    <div class="col-3">
                        <img src="@imageUrl" class="img-fluid rounded border cursor-pointer" onclick="changeImage(this.src)" alt="@Model.Name">
                    </div>
                    <div class="col-3">
                        <img src="@imageUrl" class="img-fluid rounded border cursor-pointer" onclick="changeImage(this.src)" alt="@Model.Name">
                    </div>
                </div>
            </div>

            <!-- Product Info -->
            <div class="col-md-6">
                <h1 class="mb-3">@Model.Name</h1>
                <div class="rating mb-3">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(Model.Rating)) { <i class="fas fa-star text-warning"></i> }
                        else { <i class="far fa-star text-warning"></i> }
                    }
                    <span class="ms-2">(@Model.Rating) - @Model.ReviewCount đánh giá</span>
                </div>
                <div class="price mb-4">
                    <span class="h2 text-danger fw-bold">@Model.Price.ToString("#,##0")đ</span>
                    @if (hasDiscount)
                    {
                        <span class="text-muted text-decoration-line-through ms-2">@Model.OldPrice!.Value.ToString("#,##0")đ</span>
                        <span class="badge bg-danger ms-2">-@discountPercent%</span>
                    }
                </div>

                <div class="mb-4">
                    <h5>Mô Tả Sản Phẩm</h5>
                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <div class="text-muted">@Html.Raw(Model.Description)</div>
                    }
                    else
                    {
                        <p class="text-muted">Chưa có mô tả cho sản phẩm này.</p>
                    }
                </div>

                <div class="mb-4">
                    <h6 class="mb-3">Số Lượng:</h6>
                    <div class="input-group" style="width: 150px;">
                        <button class="btn btn-outline-secondary" type="button" onclick="decreaseQuantity()">-</button>
                        <input type="number" class="form-control text-center" value="1" min="1" id="quantity">
                        <button class="btn btn-outline-secondary" type="button" onclick="increaseQuantity()">+</button>
                    </div>
                </div>

                <div class="d-grid gap-2 d-md-flex mb-4">
                    <button class="btn btn-primary btn-lg flex-fill">
                        <i class="fas fa-shopping-cart me-2"></i>Thêm Vào Giỏ Hàng
                    </button>
                    <button class="btn btn-outline-danger btn-lg">
                        <i class="fas fa-heart"></i>
                    </button>
                </div>

                <div class="border-top pt-4">
                    <div class="row text-center">
                        <div class="col-4">
                            <i class="fas fa-shipping-fast fa-2x text-primary mb-2"></i>
                            <p class="small mb-0">Miễn phí vận chuyển</p>
                        </div>
                        <div class="col-4">
                            <i class="fas fa-undo fa-2x text-primary mb-2"></i>
                            <p class="small mb-0">Đổi trả trong 7 ngày</p>
                        </div>
                        <div class="col-4">
                            <i class="fas fa-shield-alt fa-2x text-primary mb-2"></i>
                            <p class="small mb-0">Bảo hành chính hãng</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Tabs -->
        <div class="row mt-5">
            <div class="col-12">
                <ul class="nav nav-tabs" id="productTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="description-tab" data-bs-toggle="tab" data-bs-target="#description" type="button">
                            Mô Tả
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="specs-tab" data-bs-toggle="tab" data-bs-target="#specs" type="button">
                            Thông Số
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button">
                            Đánh Giá (120)
                        </button>
                    </li>
                </ul>
                <div class="tab-content p-4 border border-top-0 rounded-bottom" id="productTabsContent">
                    <div class="tab-pane fade show active" id="description" role="tabpanel">
                        <h5>Chi Tiết Sản Phẩm</h5>
                        @if (!string.IsNullOrWhiteSpace(Model.Description))
                        {
                            <div>@Html.Raw(Model.Description)</div>
                        }
                        else
                        {
                            <p class="text-muted">Chưa có mô tả chi tiết.</p>
                        }
                    </div>
                    <div class="tab-pane fade" id="specs" role="tabpanel">
                        <table class="table">
                            <tbody>
                                <tr>
                                    <th>Danh Mục</th>
                                    <td>@(Model.Category?.Name ?? "Chưa cập nhật")</td>
                                </tr>
                                <tr>
                                    <th>Tồn Kho</th>
                                    <td>@Model.Stock</td>
                                </tr>
                                <tr>
                                    <th>Đánh Giá</th>
                                    <td>@Model.Rating</td>
                                </tr>
                                <tr>
                                    <th>Số Lượt Đánh Giá</th>
                                    <td>@Model.ReviewCount</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="tab-pane fade" id="reviews" role="tabpanel">
                        <div class="mb-4">
                            <h5>Đánh Giá Từ Khách Hàng</h5>
                            <div class="d-flex align-items-center mb-3">
                                <div class="me-3">
                                    <h2 class="mb-0">@Model.Rating</h2>
                                    <div class="rating">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= Math.Round(Model.Rating)) { <i class="fas fa-star text-warning"></i> }
                                            else { <i class="far fa-star text-warning"></i> }
                                        }
                                    </div>
                                    <small class="text-muted">@Model.ReviewCount đánh giá</small>
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-info mb-0">Chưa có đánh giá cho sản phẩm này.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        function changeImage(src) {
            document.getElementById('mainImage').src = src;
        }

        function increaseQuantity() {
            const qty = document.getElementById('quantity');
            qty.value = parseInt(qty.value) + 1;
        }

        function decreaseQuantity() {
            const qty = document.getElementById('quantity');
            if (parseInt(qty.value) > 1) {
                qty.value = parseInt(qty.value) - 1;
            }
        }
    </script>
}
