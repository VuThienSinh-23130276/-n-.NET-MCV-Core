@model List<OrderHistoryItemViewModel>
@{
    ViewData["Title"] = "Đơn Hàng Của Tôi";
}

<section class="py-4">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="mb-0"><i class="fas fa-list me-2"></i>Đơn Hàng Của Tôi</h2>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
                <i class="fas fa-shopping-bag me-2"></i>Tiếp tục mua sắm
            </a>
        </div>

        @if (Model.Count == 0)
        {
            <div class="alert alert-info">
                Bạn chưa có đơn hàng nào.
            </div>
        }
        else
        {
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Ngày đặt</th>
                                    <th>Số món</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in Model)
                                {
                                    <tr>
                                        <td>#@o.OrderId</td>
                                        <td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@o.ItemCount</td>
                                        <td class="text-danger fw-bold">@($"{o.TotalAmount:N0}đ")</td>
                                        <td>
                                            <span class="badge @(o.Status == "Pending" ? "bg-warning text-dark" : o.Status == "Shipping" ? "bg-info text-dark" : o.Status == "Done" ? "bg-success" : "bg-secondary")">
                                                @o.Status
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-action="Details" asp-route-id="@o.OrderId" class="btn btn-sm btn-primary">
                                                <i class="fas fa-eye me-1"></i>Chi tiết
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

