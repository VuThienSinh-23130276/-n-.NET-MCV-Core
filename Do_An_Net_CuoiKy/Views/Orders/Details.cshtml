@model OrderDetailsViewModel
@{
    ViewData["Title"] = $"Chi tiết đơn #{Model.OrderId}";
}

<section class="py-4">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="mb-0"><i class="fas fa-receipt me-2"></i>Đơn hàng #@Model.OrderId</h2>
            <a asp-action="History" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Sản phẩm</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-center">SL</th>
                                        <th class="text-end">Thành tiền</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var l in Model.Lines)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    @if (!string.IsNullOrWhiteSpace(l.ImageUrl))
                                                    {
                                                        <img src="@l.ImageUrl" alt="@l.ProductName" class="rounded me-2" style="width:48px;height:48px;object-fit:cover;" />
                                                    }
                                                    <div class="fw-semibold">@l.ProductName</div>
                                                </div>
                                            </td>
                                            <td class="text-end">@($"{l.Price:N0}đ")</td>
                                            <td class="text-center">@l.Quantity</td>
                                            <td class="text-end text-danger fw-bold">@($"{l.LineTotal:N0}đ")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold">Tổng cộng</span>
                            <span class="fw-bold text-danger">@($"{Model.TotalAmount:N0}đ")</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Thông tin đơn</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")
                        </div>
                        <div class="mb-3">
                            <strong>Trạng thái:</strong>
                            <span class="badge @(Model.Status == "Pending" ? "bg-warning text-dark" : Model.Status == "Shipping" ? "bg-info text-dark" : Model.Status == "Done" ? "bg-success" : "bg-secondary")">
                                @Model.Status
                            </span>
                        </div>
                        <div class="mb-2">
                            <strong>Người nhận:</strong> @Model.ShippingName
                        </div>
                        <div class="mb-2">
                            <strong>SĐT:</strong> @Model.ShippingPhone
                        </div>
                        <div class="mb-2">
                            <strong>Địa chỉ:</strong> @Model.ShippingAddress
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.Notes))
                        {
                            <div class="mt-3">
                                <strong>Ghi chú:</strong>
                                <div class="text-muted">@Model.Notes</div>
                            </div>
                        }

                        @if (Model.Status == "Pending")
                        {
                            <hr />
                            <form asp-action="Cancel" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.OrderId" />
                                <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Bạn chắc chắn muốn hủy đơn này?');">
                                    <i class="fas fa-times-circle me-2"></i>Hủy đơn
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

