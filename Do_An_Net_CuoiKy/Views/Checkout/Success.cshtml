@{
    ViewData["Title"] = "Đặt Hàng Thành Công";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 text-center">
                <div class="card shadow-lg border-0">
                    <div class="card-body p-5">
                        <div class="mb-4">
                            <i class="fas fa-check-circle fa-5x text-success"></i>
                        </div>
                        <h2 class="mb-3">Đặt Hàng Thành Công!</h2>
                        <p class="text-muted mb-4">
                            Cảm ơn bạn đã đặt hàng. Chúng tôi sẽ xử lý đơn hàng của bạn trong thời gian sớm nhất.
                        </p>
                        <div class="alert alert-info">
                            <strong>Mã đơn hàng:</strong> #ORD123456<br>
                            <strong>Ngày đặt:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")<br>
                            <strong>Tổng tiền:</strong> 600.000đ
                        </div>
                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
                                <i class="fas fa-home me-2"></i>Về Trang Chủ
                            </a>
                            <a href="#" class="btn btn-outline-primary btn-lg">
                                <i class="fas fa-list me-2"></i>Xem Đơn Hàng
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
