@model List<Do_An_Net_CuoiKy.Models.Cart>
@{
    ViewData["Title"] = "Giỏ Hàng";
    var subtotal = Model?.Where(c => c.Product != null).Sum(c => c.Product!.Price * c.Quantity) ?? 0m;
    var shippingFee = 0m;
    var discount = 0m;
    var total = subtotal + shippingFee - discount;
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Giỏ Hàng</li>
        </ol>
    </div>
</nav>

<!-- Cart Section -->
<section class="py-4">
    <div class="container">
        <h2 class="mb-4"><i class="fas fa-shopping-cart me-2"></i>Giỏ Hàng Của Bạn</h2>

        <div class="row">
            <!-- Cart Items -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        @if (Model == null || !Model.Any())
                        {
                            <div class="alert alert-info mb-0">Giỏ hàng của bạn đang trống.</div>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                var fallbackImageUrl = Url.Content("~/logo.png");
                                var imageUrl = string.IsNullOrWhiteSpace(item.Product?.ImageUrl)
                                    ? fallbackImageUrl
                                    : item.Product!.ImageUrl.Trim().Replace("\\", "/");
                                if (!string.IsNullOrWhiteSpace(imageUrl) &&
                                    !imageUrl.StartsWith("http://") &&
                                    !imageUrl.StartsWith("https://") &&
                                    !imageUrl.StartsWith("/"))
                                {
                                    if (imageUrl.StartsWith("~/"))
                                    {
                                        imageUrl = Url.Content(imageUrl);
                                    }
                                    else
                                    {
                                        imageUrl = "/" + imageUrl.TrimStart('/');
                                    }
                                }

                                <div class="cart-item">
                                    <div class="row align-items-center">
                                        <div class="col-md-2">
                                            <img src="@imageUrl" class="img-fluid rounded" alt="@item.Product?.Name" onerror="this.src='@fallbackImageUrl'">
                                        </div>
                                        <div class="col-md-4">
                                            <h6 class="mb-1">@item.Product?.Name</h6>
                                            <small class="text-muted">Mã SP: #@item.ProductId</small>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="input-group">
                                                <button class="btn btn-outline-secondary btn-sm" type="button">-</button>
                                                <input type="number" class="form-control form-control-sm text-center" value="@item.Quantity" min="1">
                                                <button class="btn btn-outline-secondary btn-sm" type="button">+</button>
                                            </div>
                                        </div>
                                        <div class="col-md-2 text-center">
                                            <strong class="text-danger">@((item.Product?.Price ?? 0m).ToString("#,##0"))đ</strong>
                                        </div>
                                        <div class="col-md-2 text-end">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="mt-3 pt-3 border-top">
                                <a href="@Url.Action("Index", "Product")" class="btn btn-outline-primary">
                                    <i class="fas fa-arrow-left me-2"></i>Tiếp Tục Mua Sắm
                                </a>
                                <button class="btn btn-outline-danger float-end">
                                    <i class="fas fa-trash-alt me-2"></i>Xóa Tất Cả
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Cart Summary -->
            <div class="col-md-4">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-calculator me-2"></i>Tổng Kết</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span>@subtotal.ToString("#,##0")đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển:</span>
                            <span class="text-success">@((shippingFee == 0) ? "Miễn phí" : $"{shippingFee:#,##0}đ")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Giảm giá:</span>
                            <span class="text-danger">-@discount.ToString("#,##0")đ</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Tổng cộng:</strong>
                            <strong class="text-danger h5 mb-0">@total.ToString("#,##0")đ</strong>
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg @(Model == null || !Model.Any() ? "disabled" : "")">
                                <i class="fas fa-credit-card me-2"></i>Thanh Toán
                            </a>
                            <button class="btn btn-outline-primary">
                                <i class="fas fa-tag me-2"></i>Áp Dụng Mã Giảm Giá
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Promo Code -->
                <div class="card shadow-sm mt-3">
                    <div class="card-body">
                        <h6 class="mb-3"><i class="fas fa-gift me-2"></i>Mã Khuyến Mãi</h6>
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Nhập mã">
                            <button class="btn btn-primary" type="button">Áp Dụng</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
