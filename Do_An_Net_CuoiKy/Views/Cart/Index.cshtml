@{
    ViewData["Title"] = "Giỏ Hàng";
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Giỏ Hàng</li>
        </ol>
    </div>
</nav>

<!-- Cart Section -->
<section class="py-4">
    <div class="container">
        <h2 class="mb-4"><i class="fas fa-shopping-cart me-2"></i>Giỏ Hàng Của Bạn</h2>
        
        <div class="row">
            <!-- Cart Items -->
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <!-- Cart Item 1 -->
                        <div class="cart-item">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    <img src="https://via.placeholder.com/100x100?text=Product+1" class="img-fluid rounded" alt="Sản phẩm">
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-1">Thức Ăn Khô Cho Chó</h6>
                                    <small class="text-muted">Mã SP: SP001</small>
                                </div>
                                <div class="col-md-2">
                                    <div class="input-group">
                                        <button class="btn btn-outline-secondary btn-sm" type="button">-</button>
                                        <input type="number" class="form-control form-control-sm text-center" value="2" min="1">
                                        <button class="btn btn-outline-secondary btn-sm" type="button">+</button>
                                    </div>
                                </div>
                                <div class="col-md-2 text-center">
                                    <strong class="text-danger">250.000đ</strong>
                                </div>
                                <div class="col-md-2 text-end">
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Cart Item 2 -->
                        <div class="cart-item">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    <img src="https://via.placeholder.com/100x100?text=Product+2" class="img-fluid rounded" alt="Sản phẩm">
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-1">Đồ Chơi Xương Gặm</h6>
                                    <small class="text-muted">Mã SP: SP002</small>
                                </div>
                                <div class="col-md-2">
                                    <div class="input-group">
                                        <button class="btn btn-outline-secondary btn-sm" type="button">-</button>
                                        <input type="number" class="form-control form-control-sm text-center" value="1" min="1">
                                        <button class="btn btn-outline-secondary btn-sm" type="button">+</button>
                                    </div>
                                </div>
                                <div class="col-md-2 text-center">
                                    <strong class="text-danger">150.000đ</strong>
                                </div>
                                <div class="col-md-2 text-end">
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Cart Item 3 -->
                        <div class="cart-item">
                            <div class="row align-items-center">
                                <div class="col-md-2">
                                    <img src="https://via.placeholder.com/100x100?text=Product+3" class="img-fluid rounded" alt="Sản phẩm">
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-1">Vòng Cổ Thời Trang</h6>
                                    <small class="text-muted">Mã SP: SP003</small>
                                </div>
                                <div class="col-md-2">
                                    <div class="input-group">
                                        <button class="btn btn-outline-secondary btn-sm" type="button">-</button>
                                        <input type="number" class="form-control form-control-sm text-center" value="1" min="1">
                                        <button class="btn btn-outline-secondary btn-sm" type="button">+</button>
                                    </div>
                                </div>
                                <div class="col-md-2 text-center">
                                    <strong class="text-danger">180.000đ</strong>
                                </div>
                                <div class="col-md-2 text-end">
                                    <button class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="mt-3 pt-3 border-top">
                            <a href="@Url.Action("Index", "Product")" class="btn btn-outline-primary">
                                <i class="fas fa-arrow-left me-2"></i>Tiếp Tục Mua Sắm
                            </a>
                            <button class="btn btn-outline-danger float-end">
                                <i class="fas fa-trash-alt me-2"></i>Xóa Tất Cả
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cart Summary -->
            <div class="col-md-4">
                <div class="card shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-calculator me-2"></i>Tổng Kết</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span>580.000đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển:</span>
                            <span class="text-success">Miễn phí</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Giảm giá:</span>
                            <span class="text-danger">-50.000đ</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Tổng cộng:</strong>
                            <strong class="text-danger h5 mb-0">530.000đ</strong>
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg">
                                <i class="fas fa-credit-card me-2"></i>Thanh Toán
                            </a>
                            <button class="btn btn-outline-primary">
                                <i class="fas fa-tag me-2"></i>Áp Dụng Mã Giảm Giá
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Promo Code -->
                <div class="card shadow-sm mt-3">
                    <div class="card-body">
                        <h6 class="mb-3"><i class="fas fa-gift me-2"></i>Mã Khuyến Mãi</h6>
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Nhập mã">
                            <button class="btn btn-primary" type="button">Áp Dụng</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
