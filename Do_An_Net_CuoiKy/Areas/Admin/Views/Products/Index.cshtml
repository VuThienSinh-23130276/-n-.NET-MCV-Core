@model List<Do_An_Net_CuoiKy.Models.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";
}

@Html.AntiForgeryToken()

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold">Quản lý sản phẩm</h3>
        <small class="text-muted">Cửa hàng thú cưng</small>
    </div>

    <button class="btn btn-primary" onclick="openCreateProduct()">
        + Thêm sản phẩm
    </button>
</div>

<!-- THỐNG KÊ -->
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <div class="text-muted">Tổng sản phẩm</div>
            <h3>@ViewBag.Total</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <div class="text-muted">Đang hoạt động</div>
            <h3 class="text-success" id="activeCount">
                @ViewBag.Active
            </h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <div class="text-muted">Sắp hết hàng</div>
            <h3 class="text-warning">@ViewBag.LowStock</h3>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <div class="text-muted">Tổng giá trị kho</div>
            <h3 class="text-primary">
                @String.Format("{0:N0} đ", ViewBag.InventoryValue)
            </h3>
        </div>
    </div>

</div>


<!-- TABLE -->
<div class="table-responsive">
    <table class="table table-hover align-middle" id="productTable">
        <thead class="table-light">
            <tr class="text-center">
                <th style="width:60px">ID</th>
                <th style="width:80px">Ảnh</th>
                <th>Tên</th>
                <th>Danh mục</th>
                <th>Giá</th>
                <th>Tồn</th>
                <th>Rating</th>
                <th>Kích hoạt</th>
                <th style="width:120px"></th>
            </tr>
        </thead>

        <tbody>
            @{
                int stt = 1;
            }
            @foreach (var p in Model)
            {
                <tr id="row-@p.Id">
                    <td class="text-center stt">@stt</td>

                    <td class="text-center">
                        <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/no-image.png" : p.ImageUrl)"
                             style="width:50px;height:50px;object-fit:cover"
                             class="rounded border" />
                    </td>

                    <td>
                        <strong>@p.Name</strong><br />
                        <small class="text-muted text-truncate d-inline-block" style="max-width:200px">
                            @p.Description
                        </small>
                    </td>

                    <td>
                        <span class="badge bg-primary">@p.Category?.Name</span>
                    </td>

                    <td>
                        <strong>@String.Format("{0:N0} đ", p.Price)</strong><br />
                        @if (p.OldPrice != null)
                        {
                            <small class="text-muted text-decoration-line-through">
                                @String.Format("{0:N0} đ", p.OldPrice)
                            </small>
                        }
                    </td>

                    <td>
                        <span class="badge @(p.Stock < 20 ? "bg-warning text-dark" : "bg-success")">
                            @p.Stock
                        </span>
                    </td>

                    <td>
                        ⭐ @p.Rating (@p.ReviewCount)
                    </td>

                    <td class="text-center">
                        <input type="checkbox"
                               class="form-check-input"
                               @(p.IsActive ? "checked" : "")
                               onchange="toggleProductActive(@p.Id, this)" />
                    </td>

                    <td class="text-end">
                        <button class="btn btn-sm btn-warning me-1"
                                onclick="openEditProduct(@p.Id)">
                            <i class="fa fa-pen"></i>
                        </button>

                        <button class="btn btn-sm btn-danger"
                                onclick="deleteProduct(@p.Id)">
                            <i class="fa fa-trash"></i>
                        </button>
                    </td>
                </tr>

                stt++;
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_ProductModal", new Do_An_Net_CuoiKy.Models.Product())

@section Scripts {
    <script src="~/js/admin-products.js"></script>
}
