@using Do_An_Net_CuoiKy.Models
@model IEnumerable<ApplicationUser>

<h2>Quản lý người dùng</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Email</th>
            <th>Họ tên</th>
            <th>Trạng thái</th>
            <th>Khóa</th>
            <th>Role</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Email</td>
                <td>@u.FullName</td>
                <td>
                    @if (u.LockoutEnd != null && u.LockoutEnd > DateTimeOffset.Now)
                    {
                        <span class="badge bg-danger">Bị khóa</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                </td>
                <td>
                    <a asp-action="ToggleLock" asp-route-id="@u.Id"
                       class="btn btn-warning btn-sm">
                        Khóa / Mở
                    </a>
                </td>
                <td>
                    <a asp-action="EditRole" asp-route-id="@u.Id"
                       class="btn btn-info btn-sm">
                        Phân quyền
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
