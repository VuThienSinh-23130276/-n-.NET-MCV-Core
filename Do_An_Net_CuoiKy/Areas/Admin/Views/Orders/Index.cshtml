@using Do_An_Net_CuoiKy.Models
@model IEnumerable<Order>

<h3>Quản lý đơn hàng</h3>

<form method="get" class="row mb-3">
    <div class="col-md-4">
        <input name="search" value="@ViewBag.Search"
               class="form-control"
               placeholder="Mã đơn, email, tên người nhận" />
    </div>

    <div class="col-md-3">
        <select name="status" class="form-select">
            <option value="">-- Tất cả trạng thái --</option>
            <option value="Pending">Pending</option>
            <option value="Processing">Processing</option>
            <option value="Completed">Completed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary">Lọc</button>
    </div>
</form>

<table class="table table-bordered align-middle">
    <thead>
        <tr>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th>Sản phẩm</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>#ORD-@o.Id</td>
                <td>
                    @o.ShippingName <br />
                    <small>@o.User.Email</small>
                </td>
                <td>
                    @foreach (var d in o.OrderDetails)
                    {
                        <div>@d.Product.Name (x@d.Quantity)</div>
                    }
                </td>
                <td>@o.OrderDate.ToString("dd/MM/yyyy")</td>
                <td><b>@o.TotalAmount.ToString("N0") đ</b></td>
                <td>
                    <span class="badge bg-info">@o.Status</span>
                </td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@o.Id"
                       class="btn btn-sm btn-secondary">
                        Chi tiết
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
