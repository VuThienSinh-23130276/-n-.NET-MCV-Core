@{
    ViewData["Title"] = "Dashboard";
    var topProducts = ViewBag.TopProducts as dynamic;
}

<h2>Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-bg-primary">
            <div class="card-body">
                <h5>Tổng đơn</h5>
                <h3>@ViewBag.TotalOrders</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-bg-success">
            <div class="card-body">
                <h5>Doanh thu</h5>
                <h3>@ViewBag.TotalRevenue.ToString("N0") đ</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-bg-warning">
            <div class="card-body">
                <h5>Đơn hôm nay</h5>
                <h3>@ViewBag.TodayOrders</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card text-bg-danger">
            <div class="card-body">
                <h5>Đơn chờ xử lý</h5>
                <h3>@ViewBag.PendingOrders</h3>
            </div>
        </div>
    </div>
</div>

<hr />

<h4>Trạng thái đơn hàng</h4>
<ul>
    <li>Pending: <b>@ViewBag.PendingOrders</b></li>
    <li>Processing: <b>@ViewBag.ProcessingOrders</b></li>
    <li>Completed: <b>@ViewBag.CompletedOrders</b></li>
    <li>Cancelled: <b>@ViewBag.CancelledOrders</b></li>
</ul>

<hr />

<h4>Top 5 sản phẩm bán chạy</h4>

<table class="table table-bordered w-50">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Số lượng bán</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in topProducts)
        {
            <tr>
                <td>@p.ProductName</td>
                <td>@p.Quantity</td>
            </tr>
        }
    </tbody>
</table>
